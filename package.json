{
  "name": "granary.mobile",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:user",
    "start:admin": "ng serve admin-app --port 4201",
    "start:user": "ng serve user-app --port 4200",
    "build": "npm run build:shared && ng build admin-app && ng build user-app",
    "build:shared": "ng build shared",
    "build:admin": "npm run build:shared && ng build admin-app",
    "build:user": "npm run build:shared && ng build user-app && node scripts/write-runtime-config.mjs user-app",
    "test": "npm run build:shared && ng test shared --watch=false && ng test admin-app --watch=false && ng test user-app --watch=false",
    "sync:translations": "node scripts/sync-translations.mjs",
    "i18n:sync": "node scripts/sync-translations.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.4",
    "@lucide/angular": "^1.16.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",    
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
